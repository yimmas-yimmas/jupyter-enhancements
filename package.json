{
  "name": "jupyter-enhancements",
  "displayName": "Jupyter Enhancements",
  "description": "Supercharge Jupyter Notebooks with visual cues (Flash, Backgrounds, Borders) and smart execution controls.",
  "version": "1.20.14",
  "publisher": "yimmas",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Notebooks"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onNotebookEditor:jupyter-notebook",
    "onCommand:notebook.cell.executeCellAndBelow",
    "onCommand:notebook.cell.executeCellsAbove",
    "onCommand:notebook.cell.execute",
    "onCommand:notebook.execute",
    "onCommand:jupyter.runCellAndAllBelow",
    "onCommand:jupyter.runPrecedentCells",
    "onCommand:jupyter.runDependentCells",
    "onCommand:jupyter-enhancements.splitCell",
    "onCommand:jupyter-enhancements.mergeCells",
    "onCommand:jupyter-enhancements.clearCellOutput",
    "onCommand:jupyter-enhancements.runInScratchpadAbove",
    "onCommand:jupyter-enhancements.runInScratchpadBelow",
    "onCommand:jupyter-enhancements.runAndSelectNext",
    "onCommand:jupyter-enhancements.toggleOutput",
    "onCommand:jupyter-enhancements.moveCellUp",
    "onCommand:jupyter-enhancements.moveCellDown",
    "onCommand:jupyter-enhancements.copyCell",
    "onCommand:jupyter-enhancements.pasteCell",
    "onCommand:jupyter-enhancements.copyCellDown",
    "onCommand:jupyter-enhancements.cutCell"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jupyter-enhancements.execute",
        "title": "Run Current & Below",
        "icon": "$(run-below)"
      },
      {
        "command": "jupyter-enhancements.runAndSelectNext",
        "title": "Run & Select Next",
        "icon": "$(debug-coverage)"
      },
      {
        "command": "jupyter-enhancements.runInScratchpad",
        "title": "Run Selection in Scratchpad",
        "icon": "$(add)"
      },
      {
        "command": "jupyter-enhancements.runInScratchpadAbove",
        "title": "Run Selection in Scratchpad (Above)",
        "icon": "$(arrow-up)"
      },
      {
        "command": "jupyter-enhancements.runInScratchpadBelow",
        "title": "Run Selection in Scratchpad (Below)",
        "icon": "$(arrow-down)"
      },
      {
        "command": "jupyter-enhancements.splitCell",
        "title": "Split Cell at Cursor",
        "icon": "$(split-vertical)"
      },
      {
        "command": "jupyter-enhancements.mergeCells",
        "title": "Merge Cells",
        "icon": "$(merge)"
      },
      {
        "command": "jupyter-enhancements.clearCellOutput",
        "title": "Clear Cell Output",
        "icon": "$(clear-all)"
      },
      {
        "command": "jupyter-enhancements.toggleOutput",
        "title": "Toggle Output",
        "icon": "$(output)"
      },
      {
        "command": "jupyter-enhancements.moveCellUp",
        "title": "Move Cell Up",
        "icon": "$(chevron-up)"
      },
      {
        "command": "jupyter-enhancements.moveCellDown",
        "title": "Move Cell Down",
        "icon": "$(chevron-down)"
      },
      {
        "command": "jupyter-enhancements.copyCell",
        "title": "Copy Cell",
        "icon": "$(copy)"
      },
      {
        "command": "jupyter-enhancements.pasteCell",
        "title": "Paste Cell",
        "icon": "$(file-add)"
      },
      {
        "command": "jupyter-enhancements.copyCellDown",
        "title": "Duplicate Cell (Copy Down)",
        "icon": "$(versions)"
      },
      {
        "command": "jupyter-enhancements.cutCell",
        "title": "Cut Cell",
        "icon": "$(issue-draft)"
      }
    ],
    "keybindings": [
      {
        "command": "jupyter-enhancements.runInScratchpad",
        "key": "f11",
        "when": "editorTextFocus && notebookEditorFocused"
      }
    ],
    "menus": {
      "notebook/cell/title": [
        {
          "command": "jupyter-enhancements.runAndSelectNext",
          "group": "inline/0_cellops@0",
          "when": "notebookType == jupyter-notebook"
        },

        {
          "command": "jupyter-enhancements.toggleOutput",
          "group": "inline/0_cellops@1",
          "when": "notebookType == jupyter-notebook"
        },


        {
          "command": "jupyter-enhancements.clearCellOutput",
          "group": "inline/0_cellops@2",
          "when": "notebookType == jupyter-notebook"
        },
        {
          "command": "jupyter-enhancements.runInScratchpadAbove",
          "group": "inline/0_cellops@3",
          "when": "notebookType == jupyter-notebook"
        },
        {
          "command": "jupyter-enhancements.runInScratchpadBelow",
          "group": "inline/0_cellops@4",
          "when": "notebookType == jupyter-notebook"
        },
        {
          "command": "jupyter-enhancements.splitCell",
          "group": "inline/0_cellops@5",
          "when": "notebookType == jupyter-notebook"
        },
        {
          "command": "jupyter-enhancements.mergeCells",
          "group": "inline/0_cellops@6",
          "when": "notebookType == jupyter-notebook"
        },
        {
          "command": "jupyter-enhancements.moveCellUp",
          "group": "inline/0_cellops@7",
          "when": "notebookType == jupyter-notebook"
        },
        {
          "command": "jupyter-enhancements.moveCellDown",
          "group": "inline/0_cellops@8",
          "when": "notebookType == jupyter-notebook"
        },
        {
          "command": "jupyter-enhancements.copyCell",
          "group": "inline/0_cellops@9",
          "when": "notebookType == jupyter-notebook"
        },
        {
          "command": "jupyter-enhancements.pasteCell",
          "group": "inline/0_cellops@10",
          "when": "notebookType == jupyter-notebook"
        },
        {
          "command": "jupyter-enhancements.copyCellDown",
          "group": "inline/0_cellops@11",
          "when": "notebookType == jupyter-notebook"
        },
        {
          "command": "jupyter-enhancements.cutCell",
          "group": "inline/0_cellops@12",
          "when": "notebookType == jupyter-notebook"
        },
        {
          "command": "jupyter-enhancements.execute",
          "group": "inline/run",
          "when": "notebookType == jupyter-notebook"
        }
      ],
      "notebook/cell/context": [
        {
          "command": "jupyter-enhancements.splitCell",
          "group": "1_execution@1",
          "when": "notebookType == jupyter-notebook && editorTextFocus"
        },
        {
          "command": "jupyter-enhancements.mergeCells",
          "group": "1_execution@2",
          "when": "notebookType == jupyter-notebook"
        },
        {
          "command": "jupyter-enhancements.clearCellOutput",
          "group": "1_execution@3",
          "when": "notebookType == jupyter-notebook"
        },
        {
          "command": "jupyter-enhancements.execute",
          "group": "1_execution@4",
          "when": "notebookType == jupyter-notebook"
        },
        {
          "command": "jupyter-enhancements.runInScratchpad",
          "group": "1_execution@5",
          "when": "notebookType == jupyter-notebook"
        }
      ],
      "editor/context": [
        {
          "command": "jupyter-enhancements.runInScratchpad",
          "group": "navigation",
          "when": "notebookEditorFocused"
        }
      ]
    },
    "configuration": {
      "title": "Jupyter Enhancements",
      "properties": {
        "jupyterEnhancements.layout.enableCompactView": {
          "type": "boolean",
          "default": false,
          "description": "Enables a tight layout: Verbose timing, Line numbers ON, Small output font, Consolidated Run Button, etc."
        },
        "jupyterEnhancements.kernel.optimizeStartup": {
          "type": "boolean",
          "default": true,
          "description": "Disables 'python.terminal.activateEnvironment' to significantly speed up startup when using Conda on Windows. (Default: True)"
        },
        "jupyterEnhancements.kernel.pythonPath": {
          "type": "string",
          "default": "t:/PYTHON/envs/jlab/python.exe",
          "description": "Absolute path to the Python executable (e.g. C:/Anaconda3/python.exe). Forces this kernel on startup."
        },
        "jupyterEnhancements.layout.hideCellToolbar": {
          "type": "boolean",
          "default": false,
          "description": "Hides the floating cell toolbar (Run/Delete/etc) when enabled. Shows it on the right when disabled."
        },
        "jupyterEnhancements.general.flashDuration": {
          "type": "number",
          "default": 300,
          "description": "Duration of the flash effect in milliseconds."
        },
        "jupyterEnhancements.background.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable persistent background colors (Green/Red) after execution."
        },
        "jupyterEnhancements.background.successColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#90EE9033",
          "description": "Background color for successfully executed cells."
        },
        "jupyterEnhancements.background.errorColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#FF000033",
          "description": "Background color for failed cells."
        },
        "jupyterEnhancements.flash.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable a brief flash effect upon successful execution."
        },
        "jupyterEnhancements.flash.color": {
          "type": "string",
          "format": "color-hex",
          "default": "#FFFF0066",
          "description": "Color of the flash effect."
        },
        "jupyterEnhancements.innerBorder.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable a border around the code text (Command Box) while running."
        },
        "jupyterEnhancements.innerBorder.persist": {
          "type": "boolean",
          "default": false,
          "description": "Keep the inner border (Dark Green) visible after success."
        },
        "jupyterEnhancements.innerBorder.runningColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#0078FF",
          "description": "Color of the inner border while running (Blue)."
        },
        "jupyterEnhancements.innerBorder.successColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#006400",
          "description": "Color of the inner border after success."
        },
        "jupyterEnhancements.outerBorder.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable a thick indicator bar on the left side of the cell while running."
        },
        "jupyterEnhancements.outerBorder.position": {
          "type": "string",
          "default": "left",
          "enum": [
            "left",
            "right",
            "top",
            "bottom"
          ],
          "description": "Side where the thick indicator bar appears."
        },
        "jupyterEnhancements.outerBorder.thickness": {
          "type": "string",
          "default": "6px",
          "description": "Thickness of the outer indicator bar (e.g., '2px', '8px', '12px')."
        },
        "jupyterEnhancements.outerBorder.persist": {
          "type": "boolean",
          "default": true,
          "description": "Keep the outer indicator (Dark Green) visible after success."
        },
        "jupyterEnhancements.outerBorder.runningColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#0078FF",
          "description": "Color of the outer indicator while running (Blue)."
        },
        "jupyterEnhancements.outerBorder.successColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#006400",
          "description": "Color of the outer indicator after success."
        },
        "jupyterEnhancements.scratchpad.borderColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#80808080",
          "description": "Border color for Scratchpad cells. (Default: F11)"
        },
        "jupyterEnhancements.scratchpad.borderStyle": {
          "type": "string",
          "default": "dashed",
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "double",
            "groove"
          ],
          "description": "Border style for Scratchpad cells."
        },
        "jupyterEnhancements.scratchpad.borderWidth": {
          "type": "string",
          "default": "0.5px",
          "description": "Border width for Scratchpad cells."
        },
        "jupyterEnhancements.scratchpad.backgroundColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#FFFFFF0D",
          "description": "Optional background color for Scratchpad cells."
        },
        "jupyterEnhancements.scratchpad.insertPosition": {
          "type": "string",
          "default": "below",
          "enum": [
            "below",
            "above"
          ],
          "description": "Where to insert the scratchpad cell relative to the active cell."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/node": "20.x",
    "typescript": "^5.4.0",
    "@vscode/test-cli": "^0.0.6",
    "@vscode/test-electron": "^2.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yimmas-yimmas/jupyter-enhancements.git"
  }
}